<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>PayVelix.Contracts</PackageId>
    <Title>PayVelix .NET SDK Contracts</Title>
    <Authors>PayVelix</Authors>
    <Company>PayVelix</Company>
    <Product>PayVelix .NET SDK Contracts</Product>
    <Description>Contracts and exceptions for the PayVelix .NET SDK.</Description>
    <PackageTags>payvelix;payments;crypto;merchant-api;contracts</PackageTags>
    <RepositoryUrl>https://github.com/Payvelix/Payvelix.DotNetSdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://payvelix.com</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReleaseNotes>Initial public contracts for the PayVelix .NET SDK.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

</Project>
